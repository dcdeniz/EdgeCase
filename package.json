{
  "name": "edgecase",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run docs:check && npm run lint && npm run typecheck && npm run edge:check",
    "docs:check": "node scripts/docs-check.mjs",
    "docs:watch": "node scripts/docs-watch.mjs",
    "edge:check": "deno check --config supabase/functions/api/deno.json supabase/functions/api/index.ts supabase/functions/api/app_test.ts supabase/functions/api/readiness_test.ts && deno test --allow-env=ALLOWED_ORIGINS,SUPABASE_URL,SUPABASE_ANON_KEY,PUBLIC_DEMO_MODE --config supabase/functions/api/deno.json supabase/functions/api/app_test.ts supabase/functions/api/readiness_test.ts",
    "hooks:install": "git config core.hooksPath .githooks",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:functions": "supabase functions serve --env-file supabase/functions/.env.local",
    "neat:init": "neat init .",
    "neat:apply": "neat init . --apply",
    "rag:ingest": "node scripts/rag-ingest.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@opentelemetry/auto-instrumentations-node": "^0.55.0",
    "@vercel/otel": "^2.1.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "neat.is": "^0.6.2",
    "supabase": "^2.109.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
